# Variables de entorno del servidor (api/blog.ts).
# Se configuran en Vercel → Settings → Environment Variables. NUNCA se suben al repo.
# Para probar en local hace falta `vercel dev` (con `npm run dev` no existe /api).

# Base de datos (las crea sola la integración de Upstash Redis al conectarla al proyecto)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Contraseña de la pareja para entrar en "Zona Pareja" (se comprueba en el servidor).
# Aunque se llama ADMIN_PIN, usa una frase larga (cuatro palabras al azar, por ejemplo).
# Si es demasiado corta el servidor no deja entrar a nadie y lo apunta en los logs.
ADMIN_PIN=

# Cloudinary: alojamiento de fotos y vídeos (https://cloudinary.com, plan gratuito).
# Los tres datos salen del Dashboard de Cloudinary. El API secret NUNCA va al código.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
